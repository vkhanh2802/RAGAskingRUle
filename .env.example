# Application settings. Copy to .env for local development.
REGULARAG_ENVIRONMENT=development
REGULARAG_LOG_LEVEL=INFO
REGULARAG_DATABASE_URL=postgresql://regularag:regularag@localhost:5432/regularag
REGULARAG_DATABASE_CONNECT_TIMEOUT_SECONDS=3
REGULARAG_RAG_CONFIG_PATH=configs/rag/baseline.json

# PostgreSQL container settings. These are local-development defaults only.
POSTGRES_DB=regularag
POSTGRES_USER=regularag
POSTGRES_PASSWORD=regularag
POSTGRES_PORT=5432
